# Local worker commands only. Load with: set -a; source .env; set +a
# Managed Bruce services use runtime/secrets/credentials.json instead.
HF_TOKEN=
# Optional Notion publication and private playback links.
MEETING_ARCHIVE_NOTION_TOKEN=
MEETING_ARCHIVE_NOTION_DATA_SOURCE=
MEETING_ARCHIVE_PLAYBACK_BASE_URL=
# Optional nightly window, local time, when no heavy job starts. Default 22:00-06:00; off turns it off.
MEETING_ARCHIVE_QUIET_HOURS=
